# ── MongoDB ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Database Access > create a user,
# Network Access > allow your IP or 0.0.0.0/0 for dev).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prepp365

# ── App session ──────────────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=

# ── Firebase — client SDK (safe to expose, used in the browser) ───────────
# Firebase Console > Project settings > General > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase — Admin SDK (server-only, keep secret) ────────────────────────
# Firebase Console > Project settings > Service accounts > Generate new
# private key. Copy projectId / clientEmail / privateKey from the JSON.
# Keep the \n escapes in the private key literally — the code un-escapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Razorpay — payments (Phase 3) ──────────────────────────────────────────
# Razorpay Dashboard > Settings > API Keys. Use the Test Mode keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Airpay — payments ────────────────────────────────────────────────────────
# Airpay merchant dashboard > Airpay Settings. Treat all of these as secrets.
# Also ask Airpay support to point your account's callback/response URL at
# https://<your-domain>/api/orders/airpay/return
AIRPAY_MID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_API_KEY=

# ── Not yet used (Phase 4+) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
